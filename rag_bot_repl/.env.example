# Secret API key of a Yandex Cloud service account.
YANDEX_API_KEY=

# Folder where Yandex Cloud AI Studio is enabled.
YANDEX_FOLDER_ID=

# Optional full model URI. If empty, the application uses:
# gpt://<YANDEX_FOLDER_ID>/yandexgpt/latest
YANDEX_MODEL_URI=

YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=neon_rift_knowledge
EMBEDDING_MODEL=BAAI/bge-m3
