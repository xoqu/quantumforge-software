# YandexGPT. Keep the real file outside Git.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL_URI=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# RAG.
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=neon_rift_security_test
EMBEDDING_MODEL=BAAI/bge-m3
DEVICE=cpu
TOP_K=5
MIN_RELEVANCE=0.35

# Hugging Face cache. Keep 0 on a new machine for the first start.
# After the model is cached in the Docker volume, this can be changed to 1.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Prefer a fixed Chroma version in production.
CHROMA_IMAGE=chromadb/chroma:latest
